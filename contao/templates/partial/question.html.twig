<div class="fg-faq-question level_{{ question.level }}">
    {% if question.level == 1 %}
        <h2 class="faq-title">{{ question.question|raw }}</h2>
    {% else %}
        <h3 class="faq-title">{{ question.question|raw }}</h3>
    {% endif %}
    <div class="faq-body">
        {% if question.answer %}
            <div class="fg-faq-answer">
                {{ question.answer|raw }}
            </div>
        {% endif %}
        {% if question.children %}
            <div class="fg-faq-children">
                {% for childQuestion in question.children %}
                    {% include '@Contao/partial/question.html.twig' with {'question': childQuestion} %}
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>
