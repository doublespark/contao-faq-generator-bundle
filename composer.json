{
  "name": "doublespark/contao-faq-generator-bundle",
  "type": "ds-contao-bundle",
  "description": "Generates FAQ content using AlsoAsked and Chat GPT",
  "license": "MIT",
  "authors": [
    {
      "name": "Jamie Devine",
      "homepage": "https://www.doublespark.co.uk"
    }
  ],
  "require": {
    "php": ">=8.0.0",
    "ext-curl": "*",
    "contao/core-bundle": "^5.0|^4.13"
  },
  "autoload": {
    "psr-4": {
      "Doublespark\\FaqGeneratorBundle\\": "src/"
    }
  },
  "extra": {
    "contao-manager-plugin": "Doublespark\\FaqGeneratorBundle\\ContaoManager\\Plugin"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.1"
  },
  "config": {
    "allow-plugins": {
      "contao-components/installer": true,
      "php-http/discovery": true
    }
  }
}
